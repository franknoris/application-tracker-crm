# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must NEVER be committed.

# Secret key used to sign auth tokens. Use a long random string (>= 32 chars).
SECRET_KEY=change-me-to-a-long-random-string-0123456789

# Backend database URL. Defaults to SQLite for local dev; Docker uses Postgres.
# DATABASE_URL=sqlite:///./app.db

# Token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Frontend API base URL (read at build time by Vite).
VITE_API_BASE_URL=http://localhost:8000
